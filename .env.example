POSTGRES_DB=sirasende
POSTGRES_USER=sirasende_user
POSTGRES_PASSWORD=replace_with_a_strong_local_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
SEED_ADMIN_PASSWORD=change_me

JWT_SECRET_KEY=replace-with-a-secure-random-secret-key-of-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/admin/google-calendar/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=your-32-byte-base64-fernet-key-here
GOOGLE_OAUTH_SUCCESS_REDIRECT_URI=sirasende://google-calendar/callback?status=success
GOOGLE_OAUTH_FAILURE_REDIRECT_URI=sirasende://google-calendar/callback?status=failure

